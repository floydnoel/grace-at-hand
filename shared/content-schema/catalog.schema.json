{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "minLength": 1
    },
    "isFixture": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 1
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journey"
      }
    },
    "passages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/passage"
      }
    },
    "calendar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calendar"
      }
    },
    "withdrawnIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:._-]*$",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "publishedAt",
    "isFixture",
    "items",
    "collections",
    "journeys",
    "passages",
    "calendar",
    "withdrawnIDs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graceathand.example/schemas/catalog-v1.json",
  "title": "Grace at Hand catalog v1",
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]*$",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "Pray",
            "Reflect",
            "Rest",
            "Learn"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "suitability": {
          "enum": [
            "general",
            "family",
            "adult"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0.1
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "artwork": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "howTo": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "cues": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cue"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rosarySet": {
          "anyOf": [
            {
              "enum": [
                "joyful",
                "sorrowful",
                "glorious",
                "luminous"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rosaryCues": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rosaryCue"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "subtitle",
        "category",
        "topics",
        "language",
        "suitability",
        "durationSeconds",
        "text",
        "transcript",
        "credits",
        "artwork",
        "symbol",
        "howTo",
        "audio",
        "cues",
        "rosarySet"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^(bundle:[a-z0-9._-]+\\.m4a|media/[a-f0-9]{64}\\.m4a|https://.+)$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "const": "audio/mp4"
        }
      },
      "required": [
        "revision",
        "url",
        "bytes",
        "sha256",
        "mimeType"
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paragraph": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "paragraph",
        "start",
        "end"
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]*$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "itemIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._-]*$",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "const": "en"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "symbol",
        "itemIDs",
        "revision",
        "language"
      ]
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]*$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "itemIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._-]*$",
            "minLength": 1
          },
          "minItems": 7,
          "uniqueItems": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "const": "en"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "itemIDs",
        "revision",
        "language"
      ]
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]*$",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        },
        "numberingNote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "reflection": {
          "type": "string",
          "minLength": 1
        },
        "audioItemID": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9:._-]*$",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "const": "en"
        },
        "verseNumbers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+[a-z]?$"
          }
        }
      },
      "required": [
        "id",
        "date",
        "title",
        "reference",
        "translation",
        "numberingNote",
        "verses",
        "credit",
        "reflection",
        "audioItemID",
        "revision",
        "language",
        "verseNumbers"
      ]
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "region": {
          "const": "US"
        },
        "rite": {
          "const": "roman"
        },
        "season": {
          "type": "string",
          "minLength": 1
        },
        "observance": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "const": "en"
        },
        "id": {
          "type": "string",
          "pattern": "^calendar:\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "date",
        "region",
        "rite",
        "season",
        "observance",
        "revision",
        "language",
        "id"
      ]
    },
    "rosaryCue": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  }
}
