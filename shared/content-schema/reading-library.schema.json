{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "isDevelopment": {
      "type": "boolean"
    },
    "coverage": {
      "type": "string",
      "minLength": 1
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "bible",
              "encyclical",
              "apostolicLetter",
              "spiritualClassic",
              "churchFather",
              "papalDocument"
            ]
          },
          "language": {
            "enum": ["en", "it", "la"]
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "sourceURL": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "publicDomain",
                  "licensed",
                  "linkOnly",
                  "developmentOnly"
                ]
              },
              "edition": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidenceURL": {
                "type": "string",
                "minLength": 1
              },
              "territory": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "edition",
              "statement",
              "evidenceURL",
              "territory"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "file": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "bytes"
                  ]
                },
                "verseCount": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "title",
                "reference",
                "order",
                "topics",
                "file"
              ]
            },
            "minItems": 0
          },
          "bibleCode": {
            "type": "string",
            "minLength": 1
          },
          "sourceIsDirectory": {
            "type": "boolean"
          },
          "originalType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceLanguage": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "kind",
          "language",
          "summary",
          "aliases",
          "topics",
          "sourceURL",
          "rights",
          "sections"
        ]
      },
      "minItems": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "aliases",
          "description"
        ]
      },
      "minItems": 0
    },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "introduction": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "workID": {
                  "type": "string",
                  "minLength": 1
                },
                "sectionID": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "anchor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "workID",
                "sectionID",
                "anchor",
                "note"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "introduction",
          "topics",
          "steps"
        ]
      },
      "minItems": 0
    },
    "searchIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "isDevelopment",
    "coverage",
    "works",
    "topics",
    "guides",
    "searchIndex"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grace at Hand reading library v1"
}
